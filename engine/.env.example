# Required: generate a unique random value with at least 32 characters.
ALILI_ENGINE_API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
ALILI_ENGINE_HOST=127.0.0.1
ALILI_ENGINE_PORT=8765
ALILI_ENGINE_DB_PATH=./data/jobs.sqlite3

# Optional local model server (llama.cpp-compatible OpenAI chat-completions API).
# Must be a literal loopback URL; remote/hosted endpoints are rejected.
# Example: llama-server --host 127.0.0.1 --port 8080 --model /models/your-model.gguf
ALILI_LOCAL_MODEL_URL=http://127.0.0.1:8080/v1
ALILI_LOCAL_MODEL_NAME=local-model
ALILI_LOCAL_MODEL_TIMEOUT=90
